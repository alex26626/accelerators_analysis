  <script>
      $('[data-toggle="tooltip"]').tooltip()
  
  		$('#exampleModal').on('show.bs.modal', function (event) {
        var button = $(event.relatedTarget);
        var owner = button.data('owner');
        var code = button.data('code');
        var partner = button.data('partner');
        var invite = button.data('invite');
        var modal = $(this);
        modal.find('.modal-title').text('Edit code for ' + owner);
        modal.find('#ownerInput').val(owner)
        modal.find('#codeInput').val(code)
        modal.find('#updateInviteForm').attr("action", invite)
        modal.find('#destroyInvite').attr("href", invite)
        if(partner){
          modal.find('#partnerInput').val(partner)
        }else{
          modal.find('#partnerInput option')[0].selected = true;
        }
      });
      
      $( "#demosVideoSelection" ).change(function(event) {
        var partnerSelect = $(event.currentTarget);
        var partner = partnerSelect.val();
        $('#demoVideoWell').css( "visibility", "visible" );
        $('#demoVideoFrame').attr("src", partner);
      });
      
      $( "#partnerFilter" ).change(function(event) {
        var partnerSelect = $(event.currentTarget);
        var partner = partnerSelect.val();
        $("#invites td.partner").each(function(){
          if($(this).text().indexOf(partner) >= 0){  //Check if first letter exists in the drop down value
               $(this).parent().show();

          }else{
               $(this).parent().hide();
          }
        });
      });
      
      $( "#conferenceEmailStatus" ).change(function(event) {
        var statusSelect = $(event.currentTarget);
        var status = statusSelect.val();
        window.location.replace("/attend/list"+"?grouping="+status);
      });
      
      $('#applicationSubForm').on('keyup keypress', function(e) {
        var code = e.keyCode || e.which;
        if (code == 13 && !$(e.target).is("textarea")) {
          e.preventDefault();
          return false;
        }
      });

      $('#btnSubmitApplication').click(function() {
          var $btn = $(this).button('loading')
          $('#applicationSubForm').submit();
      });

      $('#campaignConnectionForm').on('submit', function (e) {
        var email = $('#campaignConnectionEmailInput').val();
        if (email == '') {
          $('#simpleModalWarning').modal('show');
          e.preventDefault();
        }
      });
            
      $('#applicationSubForm').validator().on('submit', function (e) {
        if (e.isDefaultPrevented()) {
          // handle the invalid form...
          $('#applicationIncomplete').modal('show');
        } else {
          // everything looks good!
          var $btn = $('#newApplicationSubmitBtn').button('loading');
        }
      })
      
      $('#contactModal').on('show.bs.modal', function (event) {
        var button = $(event.relatedTarget);
        var company = button.data('company');
        var name = button.data('name');
        var modal = $(this);
        modal.find('.modal-title').text('Introduce me to ' + name);
        modal.find('#companyId').val(company)
      });
      
  </script>
  
